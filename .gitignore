# Corrected 2026-08-22: batocera-build/build/batocera.linux is now
# tracked directly in this repo (folded in via `git subtree`, buildroot
# flattened from a submodule into plain files) -- it's the actual
# buildable source tree, not a disposable checkout. batocera-build/
# patches/ + overlay/ are kept as a legacy record of what's inside it,
# not the source of truth anymore.
batocera-build/*.dmg

# Build output/downloads/ccache: regenerable, multi-hundred-GB working set.
/output/

# RetroPie-era build output (raw disk images): regenerable via
# Retropie_source/build.sh, not part of the read-only reference material.
Retropie_source/output/

# Build logs.
docs/superpowers/plans/**/*.log

# Never commit filled-in WiFi credentials.
batocera.conf

# macOS Finder metadata.
.DS_Store

# Claude Code / Superpowers tooling state (scheduled-task locks, brainstorm
# companion server state) -- not project source.
.claude/
.superpowers/
