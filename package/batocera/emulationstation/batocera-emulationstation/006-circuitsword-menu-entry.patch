+std::string ApiSystem::getCircuitSwordJoystickStatus()
+{
+	LOG(LogDebug) << "ApiSystem::getCircuitSwordJoystickStatus";
+
+	FILE *pipe = popen("circuitsword-daemon-config joystick-status", "r");
+	char line[1024];
+
+	if (pipe == NULL)
+		return "";
 
+	if (fgets(line, 1024, pipe)) {
+		strtok(line, "\n");
+		pclose(pipe);
+		return std::string(line);
+	}
+
+	pclose(pipe);
+	return "";
+}
+
+bool ApiSystem::sendCircuitSwordJoystickCommand(const std::string& cmd)
+{
+	// executeScript() runs synchronously and can block for several
+	// seconds (CALIBRATE takes up to ~12s) -- callers MUST invoke this
+	// off the UI thread (e.g. via GuiLoading), same convention as every
+	// other slow ApiSystem call in this file.
+	return executeScript("circuitsword-daemon-config joystick-cmd " + cmd);
+}
