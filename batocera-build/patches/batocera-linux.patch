diff --git a/package/batocera/core/batocera-system/batocera.conf b/package/batocera/core/batocera-system/batocera.conf
index 3738057e76..81262eaf54 100644
--- a/package/batocera/core/batocera-system/batocera.conf
+++ b/package/batocera/core/batocera-system/batocera.conf
@@ -225,7 +225,18 @@ controllers.gamecon.args=map=1
 # ------------ G - Updates ------------ #
 
 ## Automatically check for updates after booting.
-updates.enabled=1
+## Circuit-Sword: disabled by default. This device runs a custom kernel
+## (WiFi driver, hardware daemon) baked into the system image -- the
+## stock update server has no idea any of that exists, so an update would
+## silently replace it with a vanilla image (losing WiFi/fan/battery/
+## backlight/shutdown support until the custom image is reapplied via
+## `batocera-upgrade manual`). Does NOT affect game saves either way
+## (batocera-upgrade only touches /userdata/system/upgrade/), but there's
+## no reason to prompt for an update path that always needs a manual
+## follow-up anyway. Re-enable if you specifically want the stock-update
+## check (e.g. to compare version numbers) -- just don't accept the
+## resulting prompt without rebuilding+reapplying our own image first.
+updates.enabled=0
 ## Set the update type.
 ## stable -> Current stable version
 ## butterfly -> Current development verion, use at your own risk
