+#Circuit-Sword handheld
+function circuitsword_start()
+{
+    modprobe circuitsword_battery
+    modprobe circuitsword_backlight
+    rpi-circuitsword > >(logger -t rpi-circuitsword -s) 2>&1 &
+    pid=$!
+    echo "$pid" > "/tmp/rpi-circuitsword.pid"
+    wait "$pid"
+}
