diff --git a/board/batocera/scripts/post-image-script.sh b/board/batocera/scripts/post-image-script.sh
index f5843da04b..f5c17067e8 100755
--- a/board/batocera/scripts/post-image-script.sh
+++ b/board/batocera/scripts/post-image-script.sh
@@ -94,11 +94,22 @@ do
     mkdir ${GENIMAGE_TMP}
     fi
     ###
-    "${HOST_DIR}/bin/genimage" --rootpath="${TARGET_DIR}" --inputpath="${BATOCERA_BINARIES_DIR}/boot" --outputpath="${BATOCERA_BINARIES_DIR}" --config="${BATOCERA_BINARIES_DIR}/genimage.cfg" --tmppath="${GENIMAGE_TMP}" || exit 1
-
-    rm -f "${BATOCERA_BINARIES_DIR}/boot.vfat" || exit 1
-    rm -f "${BATOCERA_BINARIES_DIR}/userdata.ext4" || exit 1
-    mv "${BATOCERA_BINARIES_DIR}/batocera.img" "${BATOCERAIMG}" || exit 1
+    # Circuit-Sword: genimage's hdimage writer does many small
+    # random-access writes into a large output file (batocera.img);
+    # this reliably failed with "Input/output error" (3/3 attempts)
+    # when outputpath/tmppath were on the macOS-host-bind-mounted
+    # OUTPUT_DIR (gRPC FUSE boundary, same category as the transient
+    # EIO in WIFI-BUILD-FINDINGS.md failure #16, but deterministic
+    # here rather than one-off). Fix: build entirely on the
+    # container's own local filesystem, then copy only the final
+    # image back across the bind mount as a single whole-file write.
+    LOCAL_GENIMAGE_TMP="/tmp/genimage.tmp.local"
+    LOCAL_GENIMAGE_OUT="/tmp/genimage.out.local"
+    rm -rf "${LOCAL_GENIMAGE_TMP}" "${LOCAL_GENIMAGE_OUT}" || exit 1
+    mkdir -p "${LOCAL_GENIMAGE_OUT}" || exit 1
+    "${HOST_DIR}/bin/genimage" --rootpath="${TARGET_DIR}" --inputpath="${BATOCERA_BINARIES_DIR}/boot" --outputpath="${LOCAL_GENIMAGE_OUT}" --config="${BATOCERA_BINARIES_DIR}/genimage.cfg" --tmppath="${LOCAL_GENIMAGE_TMP}" || exit 1
+    mv "${LOCAL_GENIMAGE_OUT}/batocera.img" "${BATOCERAIMG}" || exit 1
+    rm -rf "${LOCAL_GENIMAGE_TMP}" "${LOCAL_GENIMAGE_OUT}" || exit 1
     gzip "${BATOCERAIMG}" || exit 1
 
     # rename the boot to boot_arch
diff --git a/docker.mk b/docker.mk
index 9f9e2f809a..500a5e6a23 100644
--- a/docker.mk
+++ b/docker.mk
@@ -22,6 +22,41 @@ else
 UID  := $(shell id -u)
 GID  := $(shell id -g)
 
+# Circuit-Sword local addition: BR_DOCKER_VOLUMES=1 switches DL/OUTPUT/CCACHE
+# from host bind-mounts (macOS path, crosses the VirtioFS/gRPC-FUSE boundary
+# on Docker Desktop for Mac -- the dominant bottleneck for this many-small-
+# files build) to Docker named volumes, which live entirely inside the
+# Docker Desktop Linux VM's own filesystem. No host bind-mount, no
+# file-sharing translation layer, no fchmod/EIO/clock-skew quirks tied to
+# that boundary (see WIFI-BUILD-FINDINGS.md failures #13/#15/#16) --
+# should be substantially faster for this workload (many small files,
+# many chmod/rename-heavy package installs).
+#
+# Named volumes are created automatically by `docker run` on first use.
+# To inspect/reset them: `docker volume ls`, `docker volume rm <name>`.
+# DL_DIR/OUTPUT_DIR/CCACHE_DIR must still be set (existing = macOS path)
+# for non-Docker tooling that reads them (e.g. this repo's own scripts) --
+# only the actual container mount source changes here.
+ifdef BR_DOCKER_VOLUMES
+DOCKER_VOL_DL      ?= batocera-dl
+DOCKER_VOL_CCACHE  ?= batocera-ccache
+DOCKER_VOL_OUTPUT  ?= batocera-output-$*
+
+define RUN_DOCKER
+	$(DOCKER) run -t --init --rm \
+		-e HOME \
+		-v $(PROJECT_DIR):/build \
+		-v $(DOCKER_VOL_DL):/build/buildroot/dl \
+		-v $(DOCKER_VOL_OUTPUT):/$* \
+		-v $(DOCKER_VOL_CCACHE):$(HOME)/.buildroot-ccache \
+		-w /$* \
+		-v /etc/passwd:/etc/passwd:ro \
+		-v /etc/group:/etc/group:ro \
+		-u $(UID):$(GID) \
+		$(DOCKER_OPTS) \
+		$(DOCKER_IMAGE)
+endef
+else
 define RUN_DOCKER
 	$(DOCKER) run -t --init --rm \
 		-e HOME \
@@ -37,6 +72,7 @@ define RUN_DOCKER
 		$(DOCKER_IMAGE)
 endef
 endif
+endif
 
 .PHONY: _check_docker
 _check_docker:
