# Repo-wide shellcheck config for CI (.github/workflows/lint.yml).
#
# Only muted here: SC1091, a purely informational code about
# shellcheck's static analysis not being able to follow a relative
# `source` target -- every script in batocera-build/scripts/ sources
# `./env.sh` relative to its own directory. Not a bug; shellcheck just
# can't resolve it at analysis time. Real correctness findings
# (quoting, unused vars, etc.) are fixed in the scripts themselves or
# suppressed inline with a `# shellcheck disable=...` comment plus a
# one-line reason, never muted globally here.
disable=SC1091
